{
  "format": "plain",
  "checkYo": true,
  "fileExtensions": [
    ".md"
  ],
  "lang": "ru,en",
  "ignoreText": [
    [
      "^(```|~~~)[^\\n]*\\n[\\s\\S]*?^\\1[ \\t]*$",
      "gm"
    ],
    "^---\\r?\\n[\\s\\S]*?\\r?\\n---(?:\\r?\\n|$)",
    "`[^`\\n]+`",
    "\\]\\([^\\n)]*\\)",
    "https?://[^\\s<>]+",
    "{{[^}\\n]*}}",
    "<!--[\\s\\S]*?-->",
    "</?[A-Za-z][^>\\n]*>",
    [
      "^\\s{0,3}#{1,6} +",
      "gm"
    ],
    [
      "^\\s*[-*+] +",
      "gm"
    ],
    [
      "^[ \\t]*:{2,}[ \\t]*[A-Za-z_-]*",
      "gm"
    ],
    [
      "^[ \\t]+",
      "gm"
    ],
    "\\|[ \\t]+",
    "[!\\[\\]\\|]",
    "\\*{1,2}",
    "\\{#[^}\\n]+\\}"
  ]
}
